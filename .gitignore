**/.env
**/.env.*
!**/.env.example
**/auth.json
**/data.json
**/*.pem
**/*.key

# Generated dependencies and build output.
**/node_modules/
**/dist/
**/.vite/
**/supabase/.temp/
**/supabase/.branches/

# Machine/editor clutter.
.DS_Store
Thumbs.db

# Generated browser verification screenshots.
lifeos/tests/visual-*.png
lifeos/tests/phase-handoff-desktop.png

