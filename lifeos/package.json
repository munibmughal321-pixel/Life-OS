{
  "name": "lifeos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4183 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4184 --strictPort",
    "test": "node scripts/run-tests.mjs",
    "test:browser": "node --test --test-concurrency=1 tests/phase3-auth.test.mjs tests/phase4-browser.test.mjs tests/phase2.test.mjs tests/phase-handoff.test.mjs",
    "supabase": "supabase",
    "native:sync": "npm run build && cap sync",
    "android:open": "node --env-file-if-exists=.env.android.local node_modules/@capacitor/cli/bin/capacitor open android",
    "android:build": "npm run native:sync && node --env-file-if-exists=.env.android.local scripts/android-build.mjs",
    "ios:open": "cap open ios",
    "native:doctor": "node --env-file-if-exists=.env.android.local scripts/native-doctor.mjs",
    "test:native": "node --test tests/phase5.test.mjs tests/phase5-browser.test.mjs",
    "build:deploy": "node scripts/check-deploy-env.mjs && npm run build && npm run check:release",
    "check:release": "node scripts/check-release.mjs",
    "test:release": "node --test tests/phase6.test.mjs",
    "smoke:deploy": "node scripts/smoke-deploy.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/keyboard": "8.0.5",
    "@supabase/supabase-js": "2.116.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@playwright/test": "1.63.0",
    "supabase": "2.117.0",
    "vite": "8.3.0"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
